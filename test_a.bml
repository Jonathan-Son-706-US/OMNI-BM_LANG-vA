#! comentario !#

MAIN{
  DEC $x,$y,$total, $i;
  
  WHILE($x < 25 && $x >0){
	  $total => $total + 1;
  }
  
  FOR(   $i=>0;$i<10; $i=>$i+1){
    $total => $total + $i;
    $z => $total * 1 + $x:3;
  }
  
  IF($x<$y){
    $z=>$x+$y;
	IF($x<10){
    		$z=>$z+1;
	}
  }ELSE{
    $z=>0;
  }

  WRITE $z;
  WRITE $total;
  
}
